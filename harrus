
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Instagram - Connect & Share</title>

<style>
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: Arial, sans-serif;
  background: #fafafa;
  color: #222;
}

header {
  background: white;
  padding: 18px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1px solid #ddd;
  position: sticky;
  top: 0;
}

.logo {
  font-size: 27px;
  font-weight: bold;
  color: #d62976;
}

header button, .post button {
  border: none;
  background: none;
  font-size: 20px;
  cursor: pointer;
}

.stories {
  display: flex;
  gap: 15px;
  padding: 18px 12px;
  background: white;
  overflow-x: auto;
}

.story {
  text-align: center;
  min-width: 65px;
  font-size: 12px;
}

.circle {
  width: 58px;
  height: 58px;
  border-radius: 50%;
  background: linear-gradient(45deg,#ff9900,#e1306c,#833ab4);
  padding: 3px;
  margin: auto auto 6px;
}

.circle span {
  display: flex;
  height: 100%;
  background: #eee;
  border: 2px solid white;
  border-radius: 50%;
  align-items: center;
  justify-content: center;
  font-size: 24px;
}

.post {
  background: white;
  margin: 15px 0;
  border-bottom: 1px solid #ddd;
}

.post-header {
  padding: 14px;
  font-weight: bold;
}

.post-image {
  width: 100%;
  height: 280px;
  background: linear-gradient(135deg,#833ab4,#fd1d1d,#fcb045);
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 65px;
}

.post-actions {
  padding: 12px;
  display: flex;
  gap: 18px;
}

.post-actions button {
  font-size: 25px;
}

.post-info {
  padding: 0 14px 16px;
  line-height: 1.7;
}

nav {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  background: white;
  border-top: 1px solid #ddd;
  display: flex;
  justify-content: space-around;
  padding: 14px 5px;
}

nav button {
  border: none;
  background: none;
  font-size: 23px;
  cursor: pointer;
}

nav button:active {
  color: #d62976;
}

main {
  padding-bottom: 75px;
}
</style>
</head>

<body>

<header>
  <div class="logo">Instagram</div>
  <button onclick="createPost()">＋</button>
</header>

<main>
<section class="stories">
  <div class="story">
    <div class="circle"><span>😊</span></div>
    Your story
  </div>
  <div class="story">
    <div class="circle"><span>👨</span></div>
    Daniel
  </div>
  <div class="story">
    <div class="circle"><span>👩</span></div>
    Amara
  </div>
  <div class="story">
    <div class="circle"><span>🌟</span></div>
    Friends
  </div>
  <div class="story">
    <div class="circle"><span>❤️</span></div>
    Love
  </div>
</section>

<div id="feed">

<article class="post">
  <div class="post-header">🌟 Welcome Community</div>
  <div class="post-image">📸</div>
  <div class="post-actions">
    <button onclick="likePost(this)">♡</button>
    <button onclick="alert('Comments coming soon!')">💬</button>
    <button onclick="alert('Sharing coming soon!')">↗</button>
  </div>
  <div class="post-info">
    <b>Welcome to Instagram!</b>
    <p>Connect, share your moments and discover amazing people.</p>
  </div>
</article>

</div>
</main>

<nav>
  <button onclick="location.reload()">🏠</button>
  <button onclick="alert('Search coming soon!')">🔍</button>
  <button onclick="createPost()">＋</button>
  <button onclick="alert('Messages coming soon!')">💬</button>
  <button onclick="alert('Profile coming soon!')">👤</button>
</nav>

<script>
function likePost(button) {
  button.textContent =
    button.textContent === '♡' ? '❤️' : '♡';
}

function createPost() {
  const caption = prompt('What would you like to share?');

  if (!caption) return;

  const post = document.createElement('article');
  post.className = 'post';

  post.innerHTML = `
    <div class="post-header">👤 Your post</div>
    <div class="post-image">📸</div>
    <div class="post-actions">
      <button onclick="likePost(this)">♡</button>
    </div>
    <div class="post-info">${caption}</div>
  `;

  document.getElementById('feed').prepend(post);
}
</script>

</body>
</html>
